# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET="your-strong-random-secret-here"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-strong-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# The URL of your frontend (used for CORS)
CLIENT_URL=http://localhost:5173

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=your.mail.server.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM="PPT IMS <your-email@yourdomain.com>"

# ─── File Storage (AWS S3) — Optional ─────────────────────────────────────────
# Leave empty to use local file storage (uploads/ folder)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
